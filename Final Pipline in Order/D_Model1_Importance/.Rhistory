# Required libraries
library(dplyr)
library(tidyr)
library(ggpubr)
library(rstatix)  # For repeated measures stats
# Ensure Sample is a factor
summary_df$Sample <- as.factor(summary_df$Sample)
summary_df$Model <- as.factor(summary_df$Model)
# Repeated measures ANOVA
anova_acc <- summary_df %>%
anova_test(dv = Accuracy, wid = Sample, within = Model)
print("=== Repeated Measures ANOVA (Accuracy) ===")
print(anova_acc)
# Post-hoc pairwise comparisons (paired t-tests with correction)
pairwise_acc <- summary_df %>%
pairwise_t_test(
Accuracy ~ Model, paired = TRUE, subject = Sample,
p.adjust.method = "bonferroni"
)
print("=== Pairwise Comparisons (Accuracy) ===")
print(pairwise_acc)
# Post-hoc pairwise comparisons (paired t-tests with correction)
pairwise_acc <- summary_df %>%
pairwise_t_test(
Accuracy ~ Model, paired = TRUE, subject = Sample,
p.adjust.method = "bonferroni"
)
anova_f1 <- summary_df %>%
anova_test(dv = F1_Macro, wid = Sample, within = Model)
print(anova_f1)
pairwise_f1 <- summary_df %>%
pairwise_t_test(
F1_Macro ~ Model, paired = TRUE, subject = Sample,
p.adjust.method = "bonferroni"
)
# ---- Optional: Friedman test if assumptions aren't met ----
friedman_acc <- friedman_test(Accuracy ~ Model | Sample, data = summary_df)
friedman_f1 <- friedman_test(F1_Macro ~ Model | Sample, data = summary_df)
print(friedman_acc)
print(friedman_f1)
print("=== Repeated Measures ANOVA (Accuracy) ===")
print(anova_acc)
print("=== Repeated Measures ANOVA (F1 Macro) ===")
print(anova_f1)
print("=== Friedman Test Results ===")
print(friedman_acc)
print(friedman_f1)
ggboxplot(summary_df, x = "Model", y = "Accuracy", add = "jitter") +
stat_compare_means(paired = TRUE, method = "anova")
ggboxplot(summary_df, x = "Model", y = "F1_Macro", add = "jitter") +
stat_compare_means(paired = TRUE, method = "anova")
# Convert to wide format
acc_wide <- summary_df %>%
select(Sample, Model, Accuracy) %>%
pivot_wider(names_from = Model, values_from = Accuracy)
# List of model pairs
model_names <- names(acc_wide)[-1]
model_pairs <- combn(model_names, 2, simplify = FALSE)
