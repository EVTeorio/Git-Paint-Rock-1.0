# Load necessary library
library(terra)
LeafOn <- rast("E:/LiDAR_Metrics/Metrics/LeafOff_stack.tif")
seasonal_Occ <- rast("E:/LiDAR_Metrics/ALL_Metrics.tif")
plot(seasonal_Occ)
seasonal_Occ <- rast("D:/LiDAR_Metrics/ALL_Metrics.tif")
plot(seasonal_Occ[[21]])
library(ggplot2)
layer <- seasonal_Occ[[21]]
# Define breaks focusing on -20 to 30
breaks <- seq(min(values(layer), na.rm=TRUE), max(values(layer), na.rm=TRUE), length.out=100)
# Create a color palette for values between -20 and 30, extended outside with greys
palette1 <- colorRampPalette(c("blue", "white", "red"))(length(breaks))
# Create a custom function to assign black for zero and interpolate others
vals <- values(layer)
# Make a vector of colors initialized as NA
cols <- rep(NA, length(vals))
# Assign black to zeros
cols[vals == 0] <- "black"
# For others, map values between -20 and 30 to color ramp
cols[vals < 0 & vals > -20] <- colorRampPalette(c("blue", "white"))(20)[
as.numeric(cut(vals[vals < 0 & vals > -20], breaks = 20)]
# For others, map values between -20 and 30 to color ramp
cols[vals < 0 & vals > -20] <- colorRampPalette(c("blue", "white"))(20)[
as.numeric(cut(vals[vals < 0 & vals > -20], breaks = 20))]
cols[vals > 0 & vals < 30] <- colorRampPalette(c("white", "red"))(30)[
as.numeric(cut(vals[vals > 0 & vals < 30], breaks = 30))]
# For values < -20, assign dark blue (e.g., navy)
cols[vals <= -20] <- "navy"
# For values > 30, assign dark red (e.g., darkred)
cols[vals >= 30] <- "darkred"
# Plot with these colors
plot(layer, col=cols, legend=TRUE)
# Extract values and clip to focus on -20 to 30
vals <- values(layer)
vals_clipped <- pmin(pmax(vals, -20), 30)
# Create a continuous color palette for -20 to 30
n_colors <- 1000
palette_cont <- colorRampPalette(c("blue", "white", "red"))(n_colors)
# Map clipped values to palette indices
# Normalize clipped values to [1, n_colors]
color_indices <- as.integer(((vals_clipped + 20) / 50) * (n_colors - 1)) + 1
# Assign colors based on indices
colors_assigned <- palette_cont[color_indices]
# Replace exact zero values with black
colors_assigned[vals == 0] <- "black"
# Create RGB layers
library(grDevices)
# Convert color hex to RGB
rgb_matrix <- col2rgb(colors_assigned)
# Create new SpatRaster with 3 layers (R, G, B)
r_rast <- rast(layer)
g_rast <- rast(layer)
b_rast <- rast(layer)
values(r_rast) <- rgb_matrix[1, ] / 255
values(g_rast) <- rgb_matrix[2, ] / 255
values(b_rast) <- rgb_matrix[3, ] / 255
rgb_rast <- c(r_rast, g_rast, b_rast)
names(rgb_rast) <- c("red", "green", "blue")
# Plot the RGB raster
plotRGB(rgb_rast, r = 1, g = 2, b = 3, scale = 1, axes=TRUE, main="Seasonal_Occ with black zeros")
# Plot the RGB raster
plotRGB(rgb_rast, r = 1, g = 2, b = 3, scale = 1, axes=TRUE, main="Seasonal_Occ with black zeros", legend = TRUE)
# Extract values and clip to focus on -20 to 30
vals <- values(layer)
vals_clipped <- pmin(pmax(vals, -20), 30)
# Number of colors for smooth gradient
n_colors <- 1000
# Create a custom color ramp: red (low), yellow (mid), green (high)
palette_cont <- colorRampPalette(c("red", "yellow", "green"))(n_colors)
# Map clipped values to color indices (scaled from -20 to 30)
color_indices <- as.integer(((vals_clipped + 20) / 50) * (n_colors - 1)) + 1
# Assign colors to each pixel
colors_assigned <- palette_cont[color_indices]
# Replace exact zeros with black
colors_assigned[vals == 0] <- "black"
# Convert hex colors to RGB matrix
rgb_matrix <- col2rgb(colors_assigned)
# Create RGB layers for terra raster
r_rast <- rast(layer)
g_rast <- rast(layer)
b_rast <- rast(layer)
values(r_rast) <- rgb_matrix[1, ] / 255
values(g_rast) <- rgb_matrix[2, ] / 255
values(b_rast) <- rgb_matrix[3, ] / 255
rgb_rast <- c(r_rast, g_rast, b_rast)
names(rgb_rast) <- c("red", "green", "blue")
# Plot RGB raster
plotRGB(rgb_rast, r = 1, g = 2, b = 3, scale = 1, axes = TRUE,
main = "Seasonal_Occ with black zeros",
stretch = "lin")
# Setup plot space for legend
par(mar = c(5, 4, 4, 6))  # leave room on right for legend
plot(0, 0, type = "n", axes = FALSE, xlab = "", ylab = "", main = "Color legend")
# Create legend gradient image
legend_vals <- seq(-20, 30, length.out = n_colors)
legend_colors <- palette_cont
# Add the gradient rectangle
image(x = 1, y = legend_vals, z = matrix(legend_vals, nrow = 1),
col = legend_colors, add = TRUE)
# Add ticks and labels on y-axis for legend
axis(4, at = seq(-20, 30, by = 10), las = 1)
mtext("Value", side = 4, line = 3)
# Add black dot marker for zero in legend
points(1, 0, pch = 15, col = "black", cex = 2)
text(1.1, 0, "Zero values", adj = 0)
